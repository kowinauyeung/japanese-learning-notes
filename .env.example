# Copy to .env.development (dev project) and .env.production (prod project).
# Vite loads each automatically: .env.development for `yarn dev`,
# .env.production for `yarn build`. Only VITE_-prefixed vars reach the client.
#
# These values ship inside the JS bundle and are public by design — Firestore
# security rules, not secrecy, are what protect the data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
