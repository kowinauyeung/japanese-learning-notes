# Build configuration for `vite build --mode e2e`, which swaps the Firebase
# adapters for the in-memory ones in src/lib/backend.e2e.ts.
#
# Committed deliberately, unlike the other .env files: it holds no credentials
# and points at no project. `demo-*` is Firebase's reserved prefix for a project
# that cannot exist, so even a mistake here reaches nothing real. Playwright
# needs it because the login screen prints the project id, and a screenshot
# baseline cannot be built on a value that differs per machine.
VITE_FIREBASE_PROJECT_ID=demo-goitei
