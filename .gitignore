# Original markdown notes, superseded by Firestore. Kept locally only; every
# file also remains recoverable from git history before commit 4fb4ab8, in its
# pre-correction form.
bak/

# Private AI-agent workspace
.kowin/

# Agent memory. Local tool state rather than project source, and several of the
# notes cite paths inside .kowin/ — committing them here would publish exactly
# what that folder is ignored to keep private.
.serena/

node_modules/
dist/
*.tsbuildinfo

# Vite's dependency pre-bundling cache. Normally lands in node_modules/.vite,
# but falls back to the project root in some invocations.
.vite/

# Firebase web config is public by design, but keep envs out of the repo so the
# dev and prod projects stay decoupled from the source tree.
.env*
!.env.example
# Committed on purpose: no credentials, only the mode name for the end-to-end
# build. See the file itself for why.
!.env.e2e

# Service-account private keys — never commit these. This project deliberately
# has none; `yarn auth:login` is the supported path.
service-account-*.json
.firebase/

# Repo-local gcloud config, so this project's Google identity never touches the
# machine-wide ~/.config/gcloud. Holds the ADC credential.
.gcloud/

.DS_Store
*.log

# Test output. Screenshot baselines under tests/e2e/__screenshots__ ARE
# committed — they are the expected result, not a report.
coverage/
playwright-report/
test-results/

# Local agent instructions alias. Keep the repo-owned source file (`CLAUDE.md`)
# tracked, but ignore a workstation-specific `AGENTS.md` symlink beside it.
/AGENTS.md
