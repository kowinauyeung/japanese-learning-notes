{
  "name": "goitei",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "firebase emulators:exec --only firestore --project demo-goitei 'vitest run'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "auth:login": "CLOUDSDK_CONFIG=.gcloud gcloud auth application-default login",
    "auth:revoke": "CLOUDSDK_CONFIG=.gcloud gcloud auth application-default revoke",
    "migrate:parse": "node migration/parse.mjs",
    "migrate:upload": "node migration/upload.mjs",
    "rules:dev": "firebase deploy --only firestore:rules --project dev",
    "rules:prod": "firebase deploy --only firestore:rules --project prod"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.26.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
