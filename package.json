{
  "name": "goitei",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "auth:login": "CLOUDSDK_CONFIG=.gcloud gcloud auth application-default login",
    "auth:revoke": "CLOUDSDK_CONFIG=.gcloud gcloud auth application-default revoke",
    "migrate:parse": "node migration/parse.mjs",
    "migrate:upload": "node migration/upload.mjs",
    "rules:dev": "firebase deploy --only firestore:rules --project dev",
    "rules:prod": "firebase deploy --only firestore:rules --project prod"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.26.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
