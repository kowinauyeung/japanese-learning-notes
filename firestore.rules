rules_version = '2';

// Single-user notebook: everything is readable and writable by one verified
// Google account and nobody else. Locking on the verified email rather than a
// uid means the same rules work in both projects without hard-coding two
// different uids.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'kowinauyeung@gmail.com';
    }

    match /entries/{entryId} {
      allow read, write: if isOwner();
    }

    match /entryProgress/{entryId} {
      allow read, write: if isOwner();
    }

    match /practiceSessions/{sessionId} {
      allow read, write: if isOwner();
    }

    match /wordSets/{slug} {
      allow read, write: if isOwner();
    }

    // Anything not listed above stays denied.
  }
}
