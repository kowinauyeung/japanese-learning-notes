{
  // Every script outside src and tests — the operator scripts in admin, and the
  // icon generator in scripts — in one pass. Standalone for the same reason
  // tsconfig.test.json is: these files reach into src, and a composite project
  // may only do that through a reference tsconfig.app.json cannot provide.
  //
  // This pass exists because a folder once sat outside every checker without
  // anything saying so. Measured at the time: importing a symbol that does not
  // exist from src/lib left `yarn typecheck` green. Nothing in a diff shows
  // that a file landed in an unchecked directory, so a new script folder has to
  // be added here deliberately.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // Top-level await, which the admin scripts are written with.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,

    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["admin", "scripts"]
}
