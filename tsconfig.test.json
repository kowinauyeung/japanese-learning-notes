{
  // Standalone rather than a referenced project: tests import from src through
  // the `@/` alias, and a composite project may only reach another project's
  // files through a reference — which tsconfig.app.json cannot be, because it
  // disables emit. `yarn typecheck` runs this one as a second, separate pass.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // `vite-plugin-pwa/client` is here and not only in src/vite-env.d.ts,
    // because `include` below is `tests` alone. A .d.ts that nothing imports is
    // never loaded, so the triple-slash reference that supplies
    // `virtual:pwa-register` to the app project never runs for this one — and a
    // test that reaches `@/lib/backend` pulls `@/infra/pwa/updatePort` in with
    // it and fails to resolve the module. Stated rather than inherited, since
    // this project deliberately inherits nothing.
    "types": ["node", "vite/client", "vite-plugin-pwa/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,

    // Tests read the build's decisions back out of the root config files, and
    // those import each other by explicit `.ts` path — see the note in
    // tsconfig.node.json for why. `noEmit` above is the option's precondition.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["tests"]
}
